# Multi-stage build for Render: Next.js static export + FastAPI
# Stage 1: Build the Next.js frontend
FROM node:20-slim AS frontend
WORKDIR /app/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
ENV NEXT_PUBLIC_API_URL=""
RUN npm run build

# Stage 2: Python API + static files
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=10000

WORKDIR /app

COPY requirements-api.txt .
RUN pip install -r requirements-api.txt

COPY config.py ./
COPY ledger/ ledger/
COPY agents/ agents/
COPY api/ api/
COPY evals/__init__.py evals/scoring.py evals/
COPY data/*.csv data/

# Copy the built Next.js static export
COPY --from=frontend /app/web/out web/out/

RUN useradd --create-home --uid 10001 appuser && mkdir -p logs && chown -R appuser /app
USER appuser

EXPOSE 10000
CMD exec uvicorn api.main:app --host 0.0.0.0 --port ${PORT} --proxy-headers --forwarded-allow-ips="*" --workers 1
