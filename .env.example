# ── Database ─────────────────────────────────────────────────────────────
# Local: a SQLite file path. Production: your Neon connection string.
# DATABASE_URL=data/ledger.db
# DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# ── API (FastAPI on Cloud Run) ───────────────────────────────────────────
# ENV=production turns on the safety checks (refuses to start if auth is off).
# ENV=production
# Clerk: Dashboard → API keys → "Frontend API URL"
# CLERK_ISSUER=https://your-app.clerk.accounts.dev
# Your Vercel URL(s), comma separated
# CLERK_AUTHORIZED_PARTIES=https://your-app.vercel.app
# CORS_ORIGINS=https://your-app.vercel.app
# ASK_RATE_LIMIT_PER_MINUTE=20

# Local development only: skip Clerk and act as a fixed user.
# Ignored, and the API refuses to start, when ENV=production.
# AUTH_DEV_BYPASS=1
# AUTH_DEV_ROLE=finance_lead

# ── AI ───────────────────────────────────────────────────────────────────
# Anthropic API key for AI matching
ANTHROPIC_API_KEY=sk-ant-...

# ── Streamlit prototype ──────────────────────────────────────────────────
# FINANCE_DESK_PASSWORD=changeme
